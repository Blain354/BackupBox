[Unit]
Description=Pi File Transfer Web App
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/pi-file-transfer
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/pi-file-transfer/venv/bin/python -m app.main
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

[Unit]
Description=BackupBox - sauvegarde vérifiée des cartes vers le SSD
Documentation=file:///opt/backupbox/app/docs/RASPBERRY-PI-SETUP.md
Wants=udisks2.service
After=udisks2.service network.target

[Service]
Type=simple
User=backupbox
Group=backupbox
WorkingDirectory=/opt/backupbox/app
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/backupbox/app
Environment=BACKUPBOX_PORT=80
ExecStart=/opt/backupbox/venv/bin/python -m backupbox
# Settings and history live in /var/lib/backupbox (created by systemd).
StateDirectory=backupbox
StateDirectoryMode=0750
# Port 80 without root, so the phone only needs http://10.42.0.1
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
# No ProtectSystem/PrivateTmp/PrivateMounts: they put the service in its own
# mount namespace, and mounts made later by udisks2 under /media must be visible.
Restart=on-failure
RestartSec=3
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target

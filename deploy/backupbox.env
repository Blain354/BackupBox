# /etc/default/backupbox — hardware options of BackupBox (read by systemd).
# After a change: sudo systemctl restart backupbox

# Local buffer used when no SSD is plugged in (empty = no buffer).
# On the microSD: keep it on the root filesystem. With an internal SSD: mount it
# here through /etc/fstab (BackupBox ignores disks mounted outside /media).
BACKUPBOX_BUFFER_DIR=/srv/backupbox/buffer
# Space always left free on the buffer's filesystem (protects the OS on microSD).
BACKUPBOX_BUFFER_RESERVE_GB=10

# Optional GPIO wiring (BCM numbers), see docs/MATERIEL.md. Empty = not fitted.
BACKUPBOX_BUZZER_PIN=
BACKUPBOX_LED_PIN=
BACKUPBOX_BUTTON_PIN=

# Where the phone is sent by the captive portal.
BACKUPBOX_PORTAL_URL=http://10.42.0.1/
